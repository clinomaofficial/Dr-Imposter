rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'super_admin')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSupervisor() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return (data.get('id', null) == null || data.get('id', null) is string) &&
             (data.get('email', null) == null || data.get('email', null) is string) &&
             (data.get('role', 'user') in ['user', 'admin', 'supervisor', 'super_admin']) &&
             (data.get('status', 'active') in ['active', 'blocked']);
    }

    function isTargetSuperAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) && 
             get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'super_admin';
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'inputText', 'difficulty', 'qType', 'duration', 'data']) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.timestamp is number &&
             data.inputText is string &&
             data.inputText.size() <= 1000000 &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.qType in ['Academic', 'Clinical', 'Both'] &&
             data.duration in ['15 min', '30 min', '60 min'] &&
             data.data is map;
    }

    function isValidPublicProject(data) {
      return data.keys().hasAll(['id', 'authorId', 'timestamp', 'inputText', 'difficulty', 'qType', 'duration', 'data', 'isPublished']) &&
             data.id is string &&
             data.authorId is string &&
             data.timestamp is number &&
             data.inputText is string &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.qType in ['Academic', 'Clinical', 'Both'] &&
             data.duration in ['15 min', '30 min', '60 min'] &&
             data.data is map &&
             data.isPublished is bool;
    }

    // Free game: access is never gated by a subscription document read.
    function isSubscribed() { return isSignedIn(); }

    // Rooms require a Firebase identity (anonymous identities are sufficient).
    match /rooms/{roomId} {
      function member() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function live() { return resource.data.expiresAt > request.time.toMillis(); }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function playerAt(i) {
        return request.resource.data.players.size() <= i || (
          request.resource.data.players[i].id == request.resource.data.memberIds[i] &&
          request.resource.data.players[i].name is string && request.resource.data.players[i].name.size() <= 40 &&
          request.resource.data.players[i].score is number && request.resource.data.players[i].score >= 0 &&
          request.resource.data.players[i].role in ['NORMAL', 'IMPOSTER'] &&
          request.resource.data.players[i].assignedWordId is string
        );
      }
      function validRoster() {
        return request.resource.data.players is list && request.resource.data.memberIds is list &&
          request.resource.data.players.size() == request.resource.data.memberIds.size() &&
          request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size() &&
          request.resource.data.players.size() >= 1 && request.resource.data.players.size() <= request.resource.data.maxPlayers;
      }
      function joining() {
        return resource.data.status == 'LOBBY' && !(request.auth.uid in resource.data.memberIds) &&
          changed().hasOnly(['players', 'memberIds']) &&
          request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]) &&
          request.resource.data.players.size() == resource.data.players.size() + 1 &&
          request.resource.data.players == resource.data.players.concat([request.resource.data.players[resource.data.players.size()]]) &&
          playerAt(resource.data.players.size()) && request.resource.data.players[resource.data.players.size()].id == request.auth.uid &&
          request.resource.data.players[resource.data.players.size()].score == 0 &&
          request.resource.data.players[resource.data.players.size()].role == 'NORMAL' &&
          request.resource.data.players[resource.data.players.size()].assignedWordId == '';
      }
      function leaving() {
        return member() && resource.data.status == 'LOBBY' && request.auth.uid != resource.data.hostId &&
          changed().hasOnly(['players', 'memberIds']) &&
          request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]) &&
          request.resource.data.players.size() == resource.data.players.size() - 1 &&
          request.resource.data.players.toSet().difference(resource.data.players.toSet()).size() == 0;
      }
      function voting() {
        return member() && resource.data.status == 'VOTING' &&
          changed().hasOnly(['votes', 'status', 'votedOutPlayerId']) &&
          !(request.auth.uid in resource.data.votes) &&
          request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.votes[request.auth.uid] in resource.data.memberIds &&
          ((request.resource.data.votes.size() < resource.data.players.size() && request.resource.data.status == 'VOTING' &&
            !changed().hasAny(['votedOutPlayerId'])) ||
           (request.resource.data.votes.size() == resource.data.players.size() && request.resource.data.status == 'REVEALED' &&
            request.resource.data.votedOutPlayerId in resource.data.memberIds));
      }
      function duelGuess() {
        return member() && resource.data.status == 'TWO_PLAYERS_GUESS' && resource.data.maxPlayers == 2 &&
          !(request.auth.uid in resource.data.twoPlayersGuessMatched) &&
          changed().hasOnly(['twoPlayersGuessMatched', 'players', 'status']) &&
          request.resource.data.twoPlayersGuessMatched.diff(resource.data.twoPlayersGuessMatched).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.twoPlayersGuessMatched[request.auth.uid] is string &&
          ((request.resource.data.twoPlayersGuessMatched.size() == 1 && !changed().hasAny(['players', 'status'])) ||
           (request.resource.data.twoPlayersGuessMatched.size() == 2 && request.resource.data.status == 'SCOREBOARD' &&
            request.resource.data.players[0].diff(resource.data.players[0]).affectedKeys().hasOnly(['score']) &&
            request.resource.data.players[1].diff(resource.data.players[1]).affectedKeys().hasOnly(['score']) &&
            request.resource.data.players[0].score == resource.data.players[0].score +
              (request.resource.data.twoPlayersGuessMatched[resource.data.players[0].id] == resource.data.players[1].assignedWordId ? 50 : 0) &&
            request.resource.data.players[1].score == resource.data.players[1].score +
              (request.resource.data.twoPlayersGuessMatched[resource.data.players[1].id] == resource.data.players[0].assignedWordId ? 50 : 0)));
      }
      function inquiryMove() {
        return member() && resource.data.status in ['PLAYING_DISCUSSION', 'TWO_PLAYERS_GUESS'] &&
          changed().hasOnly(['inquiry']) &&
          ((resource.data.inquiry.turnPlayerId == request.auth.uid &&
            resource.data.inquiry.activeQuestion == null &&
            request.resource.data.inquiry.diff(resource.data.inquiry).affectedKeys().hasOnly(['activeQuestion', 'activeAnswer', 'targetPlayerId']) &&
            request.resource.data.inquiry.activeQuestion is map && request.resource.data.inquiry.targetPlayerId in resource.data.memberIds) ||
           (resource.data.inquiry.targetPlayerId == request.auth.uid &&
            resource.data.inquiry.activeQuestion != null &&
            request.resource.data.inquiry.turnPlayerId == resource.data.inquiry.targetPlayerId &&
            request.resource.data.inquiry.targetPlayerId == resource.data.inquiry.turnPlayerId &&
            request.resource.data.inquiry.activeQuestion == null));
      }
      function imposterAt(i) {
        return resource.data.players.size() > i && resource.data.players[i].id == request.auth.uid && resource.data.players[i].role == 'IMPOSTER';
      }
      function isImposter() {
        return imposterAt(0) || imposterAt(1) || imposterAt(2) || imposterAt(3) || imposterAt(4) ||
          imposterAt(5) || imposterAt(6) || imposterAt(7) || imposterAt(8) || imposterAt(9);
      }
      function cycleMove() {
        return member() && resource.data.status == 'PLAYING_DISCUSSION' &&
          changed().hasOnly(['questioningCycle', 'currentCycleIdx']) &&
          resource.data.currentCycleIdx < resource.data.questioningCycle.size() &&
          resource.data.questioningCycle[resource.data.currentCycleIdx].askerId == request.auth.uid &&
          request.resource.data.currentCycleIdx == resource.data.currentCycleIdx + 1 &&
          request.resource.data.questioningCycle.size() == resource.data.questioningCycle.size();
      }
      // Lobby metadata is discoverable; live room contents are member-only.
      allow get: if isSignedIn() && (member() || (resource.data.status == 'LOBBY' && resource.data.isPublic == true));
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 25 &&
        resource.data.status == 'LOBBY' && resource.data.isPublic == true);
      allow create: if isSignedIn() && roomId.matches('^[A-Z0-9]{6}$') &&
        request.resource.data.status == 'LOBBY' && request.resource.data.isPublic == true &&
        request.resource.data.players.size() == 1 && request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.hostId == request.auth.uid && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 10 &&
        request.resource.data.createdAt >= request.time.toMillis() - 300000 &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.expiresAt <= request.time.toMillis() + 7500000 &&
        request.resource.data.secretWord == null && request.resource.data.imposterAssignedWord == null &&
        request.resource.data.votes.size() == 0 && validRoster() && playerAt(0);
      function stable() {
        return request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.maxPlayers == resource.data.maxPlayers &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          request.resource.data.isPublic == resource.data.isPublic;
      }
      function memberUpdate() {
        return member() && live() && stable() &&
          request.resource.data.memberIds == resource.data.memberIds;
      }
      function hostMove() {
        return request.resource.data.memberIds == resource.data.memberIds &&
          request.resource.data.status in ['LOBBY', 'PLAYING', 'PLAYING_DISCUSSION', 'VOTING', 'REVEALED', 'GUESSING', 'SCOREBOARD', 'TWO_PLAYERS_GUESS'] &&
          (request.resource.data.status != 'LOBBY' || (request.resource.data.secretWord == null && request.resource.data.imposterAssignedWord == null));
      }
      function memberMove() {
        return request.resource.data.memberIds != resource.data.memberIds ? leaving() :
          request.auth.uid == resource.data.hostId ? hostMove() :
           resource.data.status == 'VOTING' ? voting() :
            resource.data.status == 'TWO_PLAYERS_GUESS' ? (changed().hasAny(['twoPlayersGuessMatched']) ? duelGuess() : inquiryMove()) :
             resource.data.status == 'PLAYING_DISCUSSION' ? (changed().hasAny(['inquiry']) ? inquiryMove() : cycleMove()) :
              (resource.data.status == 'GUESSING' && request.resource.data.status == 'SCOREBOARD' && isImposter() &&
               changed().hasOnly(['players', 'imposterGuessedWordId', 'status']));
      }
      // Dispatch one operation rather than evaluating every game permission.
      allow update: if isSignedIn() && live() && stable() && validRoster() &&
        (member() ? memberMove() : joining());
      allow delete: if member();
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().get('role', 'user') == 'user'
        && incoming().get('email', '') == request.auth.token.get('email', '')
        && incoming().get('detectiveScore', 0) == 0;
      allow update: if isSignedIn() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'academicLevel', 'academicYear', 'university', 'lastLogin', 'detectiveScore'
        ])) || 
        (isAdmin() && !isTargetSuperAdmin(userId))
      ) && isValidUser(incoming());
    }

    match /users/{userId}/scoreReceipts/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && incoming().keys().hasOnly(['earned']) &&
        incoming().earned is number;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(request.resource.data);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /publicProjects/{projectId} {
      allow get: if (isSubscribed() && !exists(/databases/$(database)/documents/hiddenProjects/$(request.auth.uid + "_" + projectId))) || isSupervisor();
      allow list: if (isSubscribed() && !exists(/databases/$(database)/documents/hiddenProjects/$(request.auth.uid + "_" + projectId))) || isSupervisor();
      allow write: if isSupervisor() && isValidPublicProject(request.resource.data);
    }

    match /hiddenProjects/{hiddenId} {
      allow read, write: if isSupervisor();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }
  }
}
